APP_ENV=development
LOG_SERVICE=pocketbase-template
LOG_LEVEL=info
# Enable only when a collector such as Alloy/Loki consumes structured stdout logs.
LOG_JSON=false
# Optional: leave empty to disable remote backend error reporting.
# Any Sentry-compatible DSN is supported, including self-hosted installations.
SENTRY_DSN=
SENTRY_RELEASE=
# 0 disables HTTP transaction tracing; use a sample such as 0.1 to enable it.
SENTRY_TRACES_SAMPLE_RATE=0
