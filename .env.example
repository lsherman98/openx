# These values are public and bundled into the frontend. Never put secrets here.
VITE_APP_NAME="PocketBase Template"
VITE_APP_SLUG=pocketbase-template
# Empty uses the current origin, with Vite proxying /api in development.
VITE_POCKETBASE_URL=

# Optional diagnostics. Empty DSN keeps the Sentry SDK unloaded.
VITE_SENTRY_DSN=
# Explicit opt-in to sampled, scrubbed browser traces; 0 disables tracing.
VITE_SENTRY_TRACES_SAMPLE_RATE=0
VITE_TELEMETRY_ENVIRONMENT=production
VITE_TELEMETRY_RELEASE=
VITE_TELEMETRY_ENABLED=true
VITE_TELEMETRY_IN_DEV=false

# Optional anonymous product analytics. Both key and host are required.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
# denied until setAnalyticsConsent(true), or granted if your app already has consent.
VITE_ANALYTICS_CONSENT=denied

# Build-only source map upload; never use VITE_ for these credentials.
# Set all four values to upload hidden maps to your Sentry-compatible server.
# SENTRY_URL=https://sentry.example.com/
# SENTRY_ORG=my-organization
# SENTRY_PROJECT=my-project
# SENTRY_AUTH_TOKEN=
