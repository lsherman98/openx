{
  "name": "openx",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && pnpm typecheck && pnpm sync:public",
    "build:deploy": "python3 scripts/deploy.py release --apply",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . --max-warnings 0",
    "lint:fix": "oxlint . --fix --max-warnings 0",
    "check": "pnpm lint && pnpm build",
    "sync:public": "node scripts/sync-public.mjs",
    "pb:serve": "cd pocketbase && go run . serve --http=127.0.0.1:8090",
    "pb:typegen": "python3 scripts/generate_types.py",
    "pb:build": "cd pocketbase && go build -o server ."
  },
